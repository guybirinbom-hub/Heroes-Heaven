# dependencies
node_modules

# build output
dist
dist-ssr
*.local

# Local env (Supabase URL + publishable key). The publishable key is public-safe, but keep env
# out of git; production values live in the Cloudflare Pages dashboard. .env.example is committed.
.env
.env.*
!.env.example

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*

# Tauri
src-tauri/target
src-tauri/gen

# Foundry source clone for the data importer (not tracked)
.import-src/

# Generated ast description trees: ship ONLY the gzipped buckets (`public/ast/*.json.gz`) — the raw JSON
# is ~88 MB and individual files exceed static-host per-file limits. The runtime loader fetches the .gz
# and decompresses. `idmap.json` is a build-time-only artifact (the importer bakes refs into the ast).
public/ast/*.json
public/idmap.json
# The importer's pristine Foundry transcription reference (~18 MB) — a LOCAL build reference, never shipped.
public/core.foundry-backup.json
# Initiative-tracker bestiary/stat-block data (~51 MB) is now TRACKED — do not re-ignore it. It has
# to be in the repo for the WEB tracker to have a bestiary at all: Cloudflare Pages builds only from
# the repo, so while it was ignored "Add Combatants" came up empty on the website. The installers were
# never affected (a local `vite build` copies public/data → dist/data, which Tauri embeds), which is
# why the gap only ever showed on the web. Size is fine: the largest single file is 4.2 MB (GitHub
# warns at 50 MB, Cloudflare caps at 25 MB/file), and tracker/src/data/dataStore.ts fetches per-book
# on demand, so a visitor downloads index.json (~1.6 MB) plus only the books they actually open.

# Local audit/migration tooling & working-data (~19 MB reassessment/patch/chunk JSONs) — not needed for
# build or runtime (the compiled overlay ships as scripts/data/effect-backfill.json). Keep only the two
# render-quality SCANNERS, which are the guardrails for the description pipeline.
scripts/audit/*
!scripts/audit/ast-coverage.mjs
!scripts/audit/ast-artifacts.mjs
scripts/aon-verify/
tmptest/

# Android release signing — NEVER commit the keystore or its passwords.
# BACK THESE UP somewhere safe: losing the keystore means release updates can no longer be installed.
signing/
tsconfig.tsbuildinfo
